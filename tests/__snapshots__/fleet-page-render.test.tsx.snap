// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FleetPage — render byte-parity proof (EN golden) > renders and matches the golden EN snapshot 1`] = `"<main id="main-content"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@context":"https://schema.org","@type":"ItemList","@id":"https://rideprestigo.com/fleet#vehicles","name":"PRESTIGO Mercedes Fleet Prague","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Vehicle","@id":"https://rideprestigo.com/fleet#mercedes-benz-e-class","name":"Mercedes-Benz E-Class","description":"The first choice for airport transfers and city rides. Comfortable, discreet, efficient. Capacity: 3 passengers + luggage.","image":"https://rideprestigo.com/vehicles/e-class.avif","brand":{"@type":"Brand","name":"Mercedes-Benz"},"manufacturer":{"@type":"Organization","name":"Mercedes-Benz Group AG"},"vehicleModelDate":"2022","vehicleConfiguration":"E 220 d / E 300 de Hybrid","bodyType":"Business Sedan","fuelType":"hybrid","vehicleTransmission":"automatic","driveWheelConfiguration":"https://schema.org/RearWheelDriveConfiguration","vehicleSeatingCapacity":{"@type":"QuantitativeValue","value":3,"unitText":"passengers"},"cargoVolume":{"@type":"QuantitativeValue","value":540,"unitText":"L"},"wheelbase":"2,961 mm","numberOfAxles":2}},{"@type":"ListItem","position":2,"item":{"@type":"Vehicle","@id":"https://rideprestigo.com/fleet#mercedes-benz-s-class","name":"Mercedes-Benz S-Class","description":"For those who travel at the highest level. Rear massaging seats, ambient lighting, panoramic roof. Silence as standard.","image":"https://rideprestigo.com/vehicles/s-class.avif","brand":{"@type":"Brand","name":"Mercedes-Benz"},"manufacturer":{"@type":"Organization","name":"Mercedes-Benz Group AG"},"vehicleModelDate":"2022","vehicleConfiguration":"S 450 4MATIC / S 580 e Hybrid","bodyType":"Executive Sedan","fuelType":"hybrid","vehicleTransmission":"automatic","driveWheelConfiguration":"https://schema.org/AllWheelDriveConfiguration","vehicleSeatingCapacity":{"@type":"QuantitativeValue","value":3,"unitText":"passengers"},"cargoVolume":{"@type":"QuantitativeValue","value":550,"unitText":"L"},"wheelbase":"3,216 mm","numberOfAxles":2}},{"@type":"ListItem","position":3,"item":{"@type":"Vehicle","@id":"https://rideprestigo.com/fleet#mercedes-benz-v-class","name":"Mercedes-Benz V-Class","description":"Up to 6 passengers. Full luggage. Privacy partition available. The choice for families, groups, and multi-bag travellers who refuse to compromise.","image":"https://rideprestigo.com/vehicles/v-class.avif","brand":{"@type":"Brand","name":"Mercedes-Benz"},"manufacturer":{"@type":"Organization","name":"Mercedes-Benz Group AG"},"vehicleModelDate":"2022","vehicleConfiguration":"V 300 d Extralong AVANTGARDE","bodyType":"Executive Van","fuelType":"diesel","vehicleTransmission":"automatic","driveWheelConfiguration":"https://schema.org/RearWheelDriveConfiguration","vehicleSeatingCapacity":{"@type":"QuantitativeValue","value":6,"unitText":"passengers"},"cargoVolume":{"@type":"QuantitativeValue","value":1410,"unitText":"L"},"wheelbase":"3,200 mm","numberOfAxles":2}}]},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://rideprestigo.com"},{"@type":"ListItem","position":2,"name":"Fleet","item":"https://rideprestigo.com/fleet"}]},{"@type":"FAQPage","@id":"https://rideprestigo.com/fleet#faq","mainEntity":[{"@type":"Question","name":"Which Mercedes-Benz models does PRESTIGO operate?","acceptedAnswer":{"@type":"Answer","text":"PRESTIGO runs a three-class Mercedes-Benz fleet in Prague: the E-Class (E 220 d or E 300 de Hybrid) as our business sedan, the S-Class (S 450 4MATIC or S 580 e Hybrid) as our executive sedan, and the V-Class (V 300 d Extralong AVANTGARDE) as our six-passenger van. Every vehicle is 2022 model year or newer, 9-speed automatic transmission, and configured in black exterior with black leather or Nappa interior. Each chassis is serviced on the factory-recommended schedule by authorised Mercedes-Benz Prague technicians, and we refresh the fleet on a rolling cycle so no car remains in service long enough for its cosmetic or mechanical standard to slip. We deliberately run one marque and three silhouettes — it means every driver knows the controls, every passenger recognises the interior, and there are no surprises."}},{"@type":"Question","name":"How many passengers and how much luggage fit in each class?","acceptedAnswer":{"@type":"Answer","text":"The Mercedes E-Class seats up to 3 passengers and carries 2 large suitcases plus 2 cabin bags comfortably in its 540-litre boot — the right choice for a solo traveller or couple with full airport luggage. The S-Class has the same 3-passenger limit but adds executive-package rear legroom and massage seats; the boot is 550 litres, so luggage capacity is effectively identical to the E-Class. The V-Class seats up to 6 passengers in individual captain chairs and takes 6 large cases plus 6 cabin bags without compromise thanks to its 1,410-litre cargo area — the only fleet choice for families, board transfers, and multi-bag intercity trips. If you are carrying skis, golf bags, or oversized items, book the V-Class and tell us at booking."}},{"@type":"Question","name":"Are the vehicles insured and licensed for international travel?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every PRESTIGO vehicle is fully registered in the Czech Republic, carries commercial passenger-liability insurance and comprehensive vehicle cover underwritten by an EU insurer, and holds the Czech passenger-transport licence (koncese) required for commercial chauffeur operation. For intercity routes we carry the Czech dálniční známka, the Austrian and Slovak vignettes, and we pay every German motorway toll and every bridge or tunnel charge along the way — all included in the quoted fare. Drivers hold valid international professional driver qualifications (ŘPZD), background checks, and fluent English at minimum B2. We are happy to provide insurance certificates and vehicle documentation in advance for corporate procurement teams or diplomatic security requirements — email info@rideprestigo.com and we will send the dossier within one business day."}},{"@type":"Question","name":"Can I request a specific vehicle, colour, or interior configuration?","acceptedAnswer":{"@type":"Answer","text":"Vehicle class (E, S, or V) is always your choice and is guaranteed at booking. Within a class, every PRESTIGO car is black exterior with black leather or Nappa interior and the same specification set, so requesting a specific chassis is rarely necessary — the experience is consistent across the fleet. If you have a genuine preference (for example, a client who has travelled with a specific driver before and would like the same vehicle), note it in the booking form and we will honour the request when scheduling allows. For VIP, diplomatic, or multi-vehicle event bookings we can coordinate matching cars, pre-position them at a specific arrival time, and provide a single point of dispatch contact. Child seats, phone chargers, and bottled water are standard in every car."}},{"@type":"Question","name":"How often is the fleet serviced and replaced?","acceptedAnswer":{"@type":"Answer","text":"PRESTIGO vehicles are serviced by authorised Mercedes-Benz technicians on the manufacturer-recommended schedule — typically every 25,000 km or 12 months, whichever comes first, for E-Class and S-Class, and every 20,000 km or 12 months for V-Class. Between scheduled services we run daily pre-trip inspections covering tyre pressure and tread, fluid levels, lighting, brake response, and cabin cleanliness. Consumables (tyres, brake pads, wipers, cabin filters) are replaced well before the legal minimum. We retire and replace vehicles on a rolling 3–4 year cycle so no car in service is ever old enough to look or feel dated. If a vehicle needs unscheduled repair mid-assignment, dispatch swaps it for a matching class car immediately — you should never notice, and in practice our clients rarely do."}},{"@type":"Question","name":"Is Wi-Fi, phone charging, and child seats really included in every car?","acceptedAnswer":{"@type":"Answer","text":"Yes, included at no extra cost in every PRESTIGO vehicle. Wi-Fi runs on an enterprise 5G mobile router with unlimited data — bandwidth is good enough to take a video call from Prague to Vienna without dropping. USB-C and USB-A fast-charging ports are within reach of every seat, and Apple and Samsung fast-charge protocols are supported. We carry a full range of EU-certified (R129/i-Size) child and booster seats — rear-facing infant, forward-facing toddler, and booster — and install the right one before pickup as long as you confirm the child&rsquo;s age and weight at booking. Bottled still and sparkling water are standard; coffee, tea, and champagne are available on request for executive and VIP bookings. If you need an adapter or a specific amenity, just ask at booking."}}]}]}</script><section class="relative overflow-hidden" style="min-height: 560px;"><div class="absolute inset-0"><img alt="PRESTIGO Mercedes Fleet — Prague Chauffeur" loading="lazy" decoding="async" data-nimg="fill" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; object-fit: cover; color: transparent; filter: brightness(0.38);" sizes="100vw" srcset="/_next/image?url=%2Fhero-fleet.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fhero-fleet.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fhero-fleet.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fhero-fleet.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fhero-fleet.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fhero-fleet.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fhero-fleet.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fhero-fleet.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fhero-fleet.webp&amp;w=3840&amp;q=75"></div><div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 pt-40 pb-20"><p class="label mb-6">Mercedes Fleet · Prague</p><span class="copper-line mb-8 block"></span><h1 class="display text-[length:clamp(30px,10vw,40px)] md:text-[56px] max-w-xl">Mercedes Chauffeur Fleet. <br><span class="display-italic">Part of the experience.</span></h1><p class="body-text text-[13px] mt-6 max-w-lg" style="line-height: 1.9;">Every PRESTIGO vehicle is a late-model Mercedes-Benz, maintained to exacting standards, fully insured, and prepared before every journey. The interior is your space to think, work, or simply arrive.</p></div></section><section class="bg-anthracite py-16 md:py-24"><div class="max-w-7xl mx-auto px-6 md:px-12 flex flex-col gap-16"><div class="reveal-hidden"><div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 pb-16 border-b border-anthracite-light"><div class="relative h-64 md:h-80 overflow-hidden"><img alt="Mercedes-Benz E-Class — PRESTIGO chauffeur service Prague" width="600" height="340" decoding="async" data-nimg="1" class="w-full h-full object-contain" style="color: transparent;" sizes="(max-width: 768px) 100vw, 50vw" srcset="/_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fvehicles%2Fe-class.avif&amp;w=3840&amp;q=75"></div><div class="flex flex-col justify-center gap-6"><div><p class="label mb-2">Business Sedan</p><h2 class="display text-[28px] md:text-[34px] mb-3">Mercedes-Benz E-Class</h2><p class="body-text text-[13px]" style="line-height: 1.9;">The first choice for airport transfers and city rides. Comfortable, discreet, efficient. Capacity: 3 passengers + luggage.</p></div><ul class="flex flex-col gap-2"><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Leather interior</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Dual-zone climate control</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Onboard Wi-Fi</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">USB-C fast charging</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Bottled water</span></li></ul><dl class="border-t border-anthracite-light pt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-[11px]"><div class="flex flex-col"><dt class="font-body font-medium uppercase tracking-[0.12em] text-warmgrey/80" style="font-size: 9px;">Seats</dt><dd class="font-body font-light text-offwhite mt-1">3 passengers</dd></div><div class="flex flex-col"><dt class="font-body font-medium uppercase tracking-[0.12em] text-warmgrey/80" style="font-size: 9px;">Luggage</dt><dd class="font-body font-light text-offwhite mt-1">2 large cases + 2 cabin bags</dd></div></dl><div class="flex items-center gap-6"><a href="/book" class="btn-primary" style="padding: 10px 24px; font-size: 9px;">Book E-Class</a></div><p class="font-body font-light text-[11px] text-warmgrey">Ideal for: Airport, city, solo business travel</p></div></div></div><div class="reveal-hidden" style="animation-delay: 150ms;"><div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 pb-16 border-b border-anthracite-light"><div class="relative h-64 md:h-80 overflow-hidden"><img alt="Mercedes-Benz S-Class — PRESTIGO chauffeur service Prague" loading="lazy" width="600" height="340" decoding="async" data-nimg="1" class="w-full h-full object-contain" style="color: transparent;" sizes="(max-width: 768px) 100vw, 50vw" srcset="/_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fvehicles%2Fs-class.avif&amp;w=3840&amp;q=75"></div><div class="flex flex-col justify-center gap-6"><div><p class="label mb-2">Executive Sedan</p><h2 class="display text-[28px] md:text-[34px] mb-3">Mercedes-Benz S-Class</h2><p class="body-text text-[13px]" style="line-height: 1.9;">For those who travel at the highest level. Rear massaging seats, ambient lighting, panoramic roof. Silence as standard.</p></div><ul class="flex flex-col gap-2"><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Premium Nappa leather</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Rear massage seats</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Ambient lighting</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Executive rear package</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Champagne on request</span></li></ul><dl class="border-t border-anthracite-light pt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-[11px]"><div class="flex flex-col"><dt class="font-body font-medium uppercase tracking-[0.12em] text-warmgrey/80" style="font-size: 9px;">Seats</dt><dd class="font-body font-light text-offwhite mt-1">3 passengers</dd></div><div class="flex flex-col"><dt class="font-body font-medium uppercase tracking-[0.12em] text-warmgrey/80" style="font-size: 9px;">Luggage</dt><dd class="font-body font-light text-offwhite mt-1">2 large cases + 2 cabin bags</dd></div></dl><div class="flex items-center gap-6"><a href="/book" class="btn-primary" style="padding: 10px 24px; font-size: 9px;">Book S-Class</a></div><p class="font-body font-light text-[11px] text-warmgrey">Ideal for: VIP, diplomatic, extended intercity</p></div></div></div><div class="reveal-hidden" style="animation-delay: 300ms;"><div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 pb-16 "><div class="relative h-64 md:h-80 overflow-hidden"><img alt="Mercedes-Benz V-Class — PRESTIGO chauffeur service Prague" loading="lazy" width="600" height="340" decoding="async" data-nimg="1" class="w-full h-full object-contain" style="color: transparent;" sizes="(max-width: 768px) 100vw, 50vw" srcset="/_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fvehicles%2Fv-class.avif&amp;w=3840&amp;q=75"></div><div class="flex flex-col justify-center gap-6"><div><p class="label mb-2">Executive Van</p><h2 class="display text-[28px] md:text-[34px] mb-3">Mercedes-Benz V-Class</h2><p class="body-text text-[13px]" style="line-height: 1.9;">Up to 6 passengers. Full luggage. Privacy partition available. The choice for families, groups, and multi-bag travellers who refuse to compromise.</p></div><ul class="flex flex-col gap-2"><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">6 captain seats</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Full luggage capacity</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Rear privacy glass</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Fold-out table</span></li><li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><span class="font-body font-light text-[12px] text-warmgrey tracking-wide">Individual reading lights</span></li></ul><dl class="border-t border-anthracite-light pt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-[11px]"><div class="flex flex-col"><dt class="font-body font-medium uppercase tracking-[0.12em] text-warmgrey/80" style="font-size: 9px;">Seats</dt><dd class="font-body font-light text-offwhite mt-1">6 passengers</dd></div><div class="flex flex-col"><dt class="font-body font-medium uppercase tracking-[0.12em] text-warmgrey/80" style="font-size: 9px;">Luggage</dt><dd class="font-body font-light text-offwhite mt-1">6 large cases + 6 cabin bags</dd></div></dl><div class="flex items-center gap-6"><a href="/book" class="btn-primary" style="padding: 10px 24px; font-size: 9px;">Book V-Class</a></div><p class="font-body font-light text-[11px] text-warmgrey">Ideal for: Groups, families, conference transfers</p></div></div></div></div></section><div aria-hidden="true" style="height: 1px; background: linear-gradient(to right, transparent 0%, var(--copper) 50%, transparent 100%);"></div><section class="theme-light bg-anthracite-mid py-16 md:py-20"><div class="max-w-7xl mx-auto px-6 md:px-12"><div class="reveal-hidden mb-14"><h2 class="display text-[28px] md:text-[36px]">Every vehicle, every time</h2></div><div class="grid grid-cols-2 md:grid-cols-4 gap-8"><div class="reveal-hidden"><div><span class="copper-line mb-5 block"></span><h3 class="font-body font-medium text-[11px] tracking-[0.15em] uppercase text-offwhite mb-2">Pre-trip inspection</h3><p class="body-text text-[12px]">Checked before every journey</p></div></div><div class="reveal-hidden" style="animation-delay: 100ms;"><div><span class="copper-line mb-5 block"></span><h3 class="font-body font-medium text-[11px] tracking-[0.15em] uppercase text-offwhite mb-2">Interior cleaned</h3><p class="body-text text-[12px]">Fresh cabin for every client</p></div></div><div class="reveal-hidden" style="animation-delay: 200ms;"><div><span class="copper-line mb-5 block"></span><h3 class="font-body font-medium text-[11px] tracking-[0.15em] uppercase text-offwhite mb-2">Climate preset</h3><p class="body-text text-[12px]">Set to your preference</p></div></div><div class="reveal-hidden" style="animation-delay: 300ms;"><div><span class="copper-line mb-5 block"></span><h3 class="font-body font-medium text-[11px] tracking-[0.15em] uppercase text-offwhite mb-2">Chargers &amp; Wi-Fi</h3><p class="body-text text-[12px]">Stay connected on the move</p></div></div></div></div></section><div aria-hidden="true" style="height: 1px; background: linear-gradient(to right, transparent 0%, var(--copper) 50%, transparent 100%);"></div><section class="bg-anthracite py-16 md:py-24"><div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-24"><div class="reveal-hidden"><div><p class="label mb-6">Why Mercedes-Benz exclusively</p><span class="copper-line mb-8 block"></span><h2 class="display text-[28px] md:text-[36px] mb-8">One marque. Three silhouettes. <span class="display-italic">Zero compromise.</span></h2></div></div><div class="reveal-hidden" style="animation-delay: 150ms;"><div class="flex flex-col gap-6"><p class="body-text text-[13px]" style="line-height: 1.9;">PRESTIGO operates a pure Mercedes-Benz fleet — not because it’s the easy choice, but because it’s the right one. For executive transport in Central Europe, Mercedes remains the undisputed standard: the E-Class is the default business sedan of every capital from Prague to Warsaw, the S-Class defines the upper tier of ground luxury, and the V-Class is the only premium van our corporate clients recognise on sight.</p><p class="body-text text-[13px]" style="line-height: 1.9;">A single-marque fleet also means consistency. Every driver already knows the controls, the service intervals, and the quirks of each chassis. Every passenger steps into an interior they already know how to use — the same climate logic, the same seat controls, the same quality of leather and stitching. There are no surprises, and in executive travel, surprises are the enemy.</p><p class="body-text text-[13px]" style="line-height: 1.9;">We refresh vehicles on a rolling schedule, well before the cosmetic or mechanical standard begins to slip. Our clients travel in a car that feels current — because it is.</p></div></div></div></section><div aria-hidden="true" style="height: 1px; background: linear-gradient(to right, transparent 0%, var(--copper) 50%, transparent 100%);"></div><section class="theme-light bg-anthracite-mid py-16 md:py-24"><div class="max-w-7xl mx-auto px-6 md:px-12"><div class="reveal-hidden"><div class="mb-14"><p class="label mb-6">Maintenance &amp; Safety</p><span class="copper-line mb-8 block"></span><h2 class="display text-[28px] md:text-[36px]">Prepared before <br><span class="display-italic">every journey.</span></h2></div></div><div class="grid grid-cols-1 md:grid-cols-3 gap-10"><div class="reveal-hidden"><div class="border border-anthracite-light p-8"><span class="copper-line mb-5 block"></span><h3 class="font-display font-light text-[20px] text-offwhite mb-3">Manufacturer-schedule servicing</h3><p class="body-text text-[12px]" style="line-height: 1.9;">Every vehicle is serviced by authorised Mercedes-Benz technicians on the factory-recommended schedule. We keep complete service records and replace consumables (tyres, brake pads, wipers) well before the legal minimum.</p></div></div><div class="reveal-hidden" style="animation-delay: 120ms;"><div class="border border-anthracite-light p-8"><span class="copper-line mb-5 block"></span><h3 class="font-display font-light text-[20px] text-offwhite mb-3">Commercial insurance, fully comprehensive</h3><p class="body-text text-[12px]" style="line-height: 1.9;">Every journey is covered by commercial passenger liability and fully comprehensive vehicle insurance, underwritten in the EU. Documentation is available on request for corporate compliance teams.</p></div></div><div class="reveal-hidden" style="animation-delay: 240ms;"><div class="border border-anthracite-light p-8"><span class="copper-line mb-5 block"></span><h3 class="font-display font-light text-[20px] text-offwhite mb-3">Daily pre-trip inspection</h3><p class="body-text text-[12px]" style="line-height: 1.9;">Tyre pressure, fluid levels, lights, and cabin cleanliness are checked before the first assignment of the day — and again between back-to-back executive bookings.</p></div></div></div></div></section><div aria-hidden="true" style="height: 1px; background: linear-gradient(to right, transparent 0%, var(--copper) 50%, transparent 100%);"></div><section class="bg-anthracite py-16 md:py-24"><div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-24"><div class="reveal-hidden"><div><p class="label mb-6">Technology onboard</p><span class="copper-line mb-8 block"></span><h2 class="display text-[28px] md:text-[36px] mb-6">A rolling office. <br><span class="display-italic">A quiet sanctuary.</span></h2><p class="body-text text-[13px]" style="line-height: 1.9;">Our passengers often arrive at the car with work still to finish — or nerves still to settle after a long flight. The cabin of every PRESTIGO vehicle is prepared for both. Whether you need to take a video call between meetings or simply close your eyes for an hour, the interior adapts to you, not the other way around.</p></div></div><div class="reveal-hidden" style="animation-delay: 150ms;"><ul class="flex flex-col gap-5"><li class="flex items-start gap-4 py-4 border-b border-anthracite-light last:border-0"><span class="mt-[9px] w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><div><p class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-2">Unlimited mobile Wi-Fi</p><p class="body-text text-[12px]" style="line-height: 1.85;">Enterprise-grade 5G router in every vehicle. Multiple devices, full bandwidth, no data caps.</p></div></li><li class="flex items-start gap-4 py-4 border-b border-anthracite-light last:border-0"><span class="mt-[9px] w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><div><p class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-2">Fast charging for every device</p><p class="body-text text-[12px]" style="line-height: 1.85;">USB-C and USB-A ports within reach of every seat. Apple and Samsung fast-charge supported.</p></div></li><li class="flex items-start gap-4 py-4 border-b border-anthracite-light last:border-0"><span class="mt-[9px] w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><div><p class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-2">Climate preset on arrival</p><p class="body-text text-[12px]" style="line-height: 1.85;">Your preferred cabin temperature is set before the car reaches you — noted once, remembered for every future booking.</p></div></li><li class="flex items-start gap-4 py-4 border-b border-anthracite-light last:border-0"><span class="mt-[9px] w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><div><p class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-2">Still and sparkling water</p><p class="body-text text-[12px]" style="line-height: 1.85;">Complimentary chilled mineral water on every transfer. Tea, coffee and champagne available on request for executive and VIP bookings.</p></div></li><li class="flex items-start gap-4 py-4 border-b border-anthracite-light last:border-0"><span class="mt-[9px] w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><div><p class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-2">Child &amp; booster seats</p><p class="body-text text-[12px]" style="line-height: 1.85;">Full range of EU-certified child restraints available at no extra charge — just note the age and weight at booking.</p></div></li><li class="flex items-start gap-4 py-4 border-b border-anthracite-light last:border-0"><span class="mt-[9px] w-1 h-1 rounded-full flex-shrink-0" style="background: var(--copper);"></span><div><p class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-2">Discreet privacy</p><p class="body-text text-[12px]" style="line-height: 1.85;">S-Class and V-Class offer privacy glass and optional rear partitions. What happens in the cabin stays in the cabin.</p></div></li></ul></div></div></section><div aria-hidden="true" style="height: 1px; background: linear-gradient(to right, transparent 0%, var(--copper) 50%, transparent 100%);"></div><section class="theme-light bg-anthracite-mid py-16 md:py-24"><div class="max-w-4xl mx-auto px-6 md:px-12"><div class="reveal-hidden"><p class="label mb-6">How we choose a class for your journey</p><span class="copper-line mb-8 block"></span><h2 class="display text-[28px] md:text-[36px] mb-10">Matching vehicle to <span class="display-italic">occasion.</span></h2></div><div class="reveal-hidden" style="animation-delay: 100ms;"><div class="flex flex-col gap-6"><p class="body-text text-[13px]" style="line-height: 1.9;">The right vehicle depends on the trip, not the price list. A solo executive arriving from London City with a briefcase and a carry-on is best served by an E-Class — efficient, quiet, and perfectly appointed for a ninety-minute airport run. A visiting principal with protocol requirements and an aide will prefer the S-Class, where rear legroom, massage seats, and the near-silent cabin become genuinely useful. A family of five with skis and luggage, or a four-person board arriving for a half-day roadshow, belongs in the V-Class — the only vehicle in the fleet that comfortably seats six adults with full luggage.</p><p class="body-text text-[13px]" style="line-height: 1.9;">If you’re unsure which class fits your booking, note your passenger count, luggage, and journey length in the booking form and our dispatcher will confirm the right pairing within minutes. For recurring corporate travel, we maintain vehicle preferences against your account profile so every trip is matched automatically.</p></div></div></div></section><div aria-hidden="true" style="height: 1px; background: linear-gradient(to right, transparent 0%, var(--copper) 50%, transparent 100%);"></div><section class="theme-light bg-anthracite-mid py-16 md:py-24"><div class="max-w-3xl mx-auto px-6 md:px-12"><div class="reveal-hidden"><p class="label mb-6">Fleet questions</p><span class="copper-line mb-8 block"></span><h2 class="display text-[28px] md:text-[36px] mb-12">About the vehicles.</h2></div><div class="flex flex-col gap-0"><div class="reveal-hidden"><div class="py-7 border-b border-anthracite-light border-t"><h3 class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-3">Which Mercedes-Benz models does PRESTIGO operate?</h3><p class="body-text text-[12px]" style="line-height: 1.9;">PRESTIGO runs a three-class Mercedes-Benz fleet in Prague: the E-Class (E 220 d or E 300 de Hybrid) as our business sedan, the S-Class (S 450 4MATIC or S 580 e Hybrid) as our executive sedan, and the V-Class (V 300 d Extralong AVANTGARDE) as our six-passenger van. Every vehicle is 2022 model year or newer, 9-speed automatic transmission, and configured in black exterior with black leather or Nappa interior. Each chassis is serviced on the factory-recommended schedule by authorised Mercedes-Benz Prague technicians, and we refresh the fleet on a rolling cycle so no car remains in service long enough for its cosmetic or mechanical standard to slip. We deliberately run one marque and three silhouettes — it means every driver knows the controls, every passenger recognises the interior, and there are no surprises.</p></div></div><div class="reveal-hidden" style="animation-delay: 80ms;"><div class="py-7 border-b border-anthracite-light "><h3 class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-3">How many passengers and how much luggage fit in each class?</h3><p class="body-text text-[12px]" style="line-height: 1.9;">The Mercedes E-Class seats up to 3 passengers and carries 2 large suitcases plus 2 cabin bags comfortably in its 540-litre boot — the right choice for a solo traveller or couple with full airport luggage. The S-Class has the same 3-passenger limit but adds executive-package rear legroom and massage seats; the boot is 550 litres, so luggage capacity is effectively identical to the E-Class. The V-Class seats up to 6 passengers in individual captain chairs and takes 6 large cases plus 6 cabin bags without compromise thanks to its 1,410-litre cargo area — the only fleet choice for families, board transfers, and multi-bag intercity trips. If you are carrying skis, golf bags, or oversized items, book the V-Class and tell us at booking.</p></div></div><div class="reveal-hidden" style="animation-delay: 160ms;"><div class="py-7 border-b border-anthracite-light "><h3 class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-3">Are the vehicles insured and licensed for international travel?</h3><p class="body-text text-[12px]" style="line-height: 1.9;">Yes. Every PRESTIGO vehicle is fully registered in the Czech Republic, carries commercial passenger-liability insurance and comprehensive vehicle cover underwritten by an EU insurer, and holds the Czech passenger-transport licence (koncese) required for commercial chauffeur operation. For intercity routes we carry the Czech dálniční známka, the Austrian and Slovak vignettes, and we pay every German motorway toll and every bridge or tunnel charge along the way — all included in the quoted fare. Drivers hold valid international professional driver qualifications (ŘPZD), background checks, and fluent English at minimum B2. We are happy to provide insurance certificates and vehicle documentation in advance for corporate procurement teams or diplomatic security requirements — email info@rideprestigo.com and we will send the dossier within one business day.</p></div></div><div class="reveal-hidden" style="animation-delay: 240ms;"><div class="py-7 border-b border-anthracite-light "><h3 class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-3">Can I request a specific vehicle, colour, or interior configuration?</h3><p class="body-text text-[12px]" style="line-height: 1.9;">Vehicle class (E, S, or V) is always your choice and is guaranteed at booking. Within a class, every PRESTIGO car is black exterior with black leather or Nappa interior and the same specification set, so requesting a specific chassis is rarely necessary — the experience is consistent across the fleet. If you have a genuine preference (for example, a client who has travelled with a specific driver before and would like the same vehicle), note it in the booking form and we will honour the request when scheduling allows. For VIP, diplomatic, or multi-vehicle event bookings we can coordinate matching cars, pre-position them at a specific arrival time, and provide a single point of dispatch contact. Child seats, phone chargers, and bottled water are standard in every car.</p></div></div><div class="reveal-hidden" style="animation-delay: 320ms;"><div class="py-7 border-b border-anthracite-light "><h3 class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-3">How often is the fleet serviced and replaced?</h3><p class="body-text text-[12px]" style="line-height: 1.9;">PRESTIGO vehicles are serviced by authorised Mercedes-Benz technicians on the manufacturer-recommended schedule — typically every 25,000 km or 12 months, whichever comes first, for E-Class and S-Class, and every 20,000 km or 12 months for V-Class. Between scheduled services we run daily pre-trip inspections covering tyre pressure and tread, fluid levels, lighting, brake response, and cabin cleanliness. Consumables (tyres, brake pads, wipers, cabin filters) are replaced well before the legal minimum. We retire and replace vehicles on a rolling 3–4 year cycle so no car in service is ever old enough to look or feel dated. If a vehicle needs unscheduled repair mid-assignment, dispatch swaps it for a matching class car immediately — you should never notice, and in practice our clients rarely do.</p></div></div><div class="reveal-hidden" style="animation-delay: 400ms;"><div class="py-7 border-b border-anthracite-light "><h3 class="font-body font-medium text-[12px] tracking-[0.1em] uppercase text-offwhite mb-3">Is Wi-Fi, phone charging, and child seats really included in every car?</h3><p class="body-text text-[12px]" style="line-height: 1.9;">Yes, included at no extra cost in every PRESTIGO vehicle. Wi-Fi runs on an enterprise 5G mobile router with unlimited data — bandwidth is good enough to take a video call from Prague to Vienna without dropping. USB-C and USB-A fast-charging ports are within reach of every seat, and Apple and Samsung fast-charge protocols are supported. We carry a full range of EU-certified (R129/i-Size) child and booster seats — rear-facing infant, forward-facing toddler, and booster — and install the right one before pickup as long as you confirm the child&amp;rsquo;s age and weight at booking. Bottled still and sparkling water are standard; coffee, tea, and champagne are available on request for executive and VIP bookings. If you need an adapter or a specific amenity, just ask at booking.</p></div></div></div></div></section><div aria-hidden="true" style="height: 1px; background: linear-gradient(to right, transparent 0%, var(--copper) 50%, transparent 100%);"></div><section class="bg-anthracite py-20"><div class="max-w-7xl mx-auto px-6 md:px-12 text-center"><div class="reveal-hidden"><h2 class="display text-[32px] md:text-[42px] mb-4">Choose your vehicle. <br><span class="display-italic">Book online.</span></h2><p class="body-text text-[13px] mt-4 mb-10">Select your preferred class at checkout.</p></div><div class="reveal-hidden" style="animation-delay: 150ms;"><a href="/book" class="btn-primary">Book a Transfer</a></div></div></section></main>"`;
