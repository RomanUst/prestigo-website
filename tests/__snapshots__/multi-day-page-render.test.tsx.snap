// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MultiDayPage — render byte-parity proof (EN golden) > renders and matches the golden EN snapshot 1`] = `"<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://rideprestigo.com"},{"@type":"ListItem","position":2,"name":"Book a Transfer","item":"https://rideprestigo.com/book"},{"@type":"ListItem","position":3,"name":"Multi-day Chauffeur","item":"https://rideprestigo.com/book/multi-day"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":["LocalBusiness","TaxiService"],"@id":"https://rideprestigo.com/#business","name":"PRESTIGO","url":"https://rideprestigo.com","telephone":"+420725986855","priceRange":"€€€","image":"https://rideprestigo.com/og-image.jpg","logo":{"@type":"ImageObject","url":"https://rideprestigo.com/logo.png","width":512,"height":512},"address":{"@type":"PostalAddress","streetAddress":"Spojovací 685","addressLocality":"Vysoký Újezd","postalCode":"252 16","addressRegion":"Central Bohemian Region","addressCountry":"CZ"}}]}</script><main style="min-height: 100vh; background: var(--anthracite); color: var(--offwhite); padding-bottom: 80px;"><section aria-labelledby="multiday-hero-heading" style="position: relative; width: 100%; min-height: clamp(420px, 55vw, 680px); display: flex; align-items: flex-end; overflow: hidden; margin-bottom: 0px;"><img alt="Prestigo chauffeur and luxury car on a multi-day journey through Central Europe" style="object-fit: cover; object-position: center 40%;" src="/multi-day-hero.png"><div aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(rgba(20, 20, 22, 0.35) 0%, rgba(20, 20, 22, 0.68) 50%, rgba(20, 20, 22, 0.96) 100%);"></div><div style="position: relative; z-index: 1; max-width: 960px; width: 100%; margin: 0px auto; padding: 48px 24px 56px;"><p style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 16px;">PRESTIGO · Multi-day chauffeur hire</p><h1 id="multiday-hero-heading" style="font-family: var(--font-cormorant); font-weight: 400; line-height: 1.1; margin-bottom: 28px; color: var(--offwhite);">One chauffeur. Every day. <br>Wherever Central Europe takes you.</h1><p style="font-family: var(--font-montserrat); font-size: 16px; line-height: 1.8; color: var(--warmgrey); max-width: 640px; margin-bottom: 20px;">Some journeys don’t fit into a single booking. A corporate roadshow spanning three cities. A family tour across Bohemia and Bavaria. A wedding weekend that moves between Prague and a countryside château. For these, you need a dedicated vehicle and a driver who knows your itinerary as well as you do.</p><p style="font-family: var(--font-montserrat); font-size: 16px; line-height: 1.8; color: var(--warmgrey); max-width: 640px;">Build your day-by-day itinerary below — mix Transfer and Hourly days freely, add intermediate stops, set departure times — and we’ll return a fixed quote within 24 hours. No online payment required: once the itinerary is right, we confirm by email and the rest is taken care of.</p></div></section><section aria-labelledby="multiday-includes-heading" style="max-width: 960px; margin: 0px auto; padding: 40px 24px; border-top: 1px solid var(--anthracite-light); border-bottom: 1px solid var(--anthracite-light);"><h2 id="multiday-includes-heading" style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 24px;">Everything included</h2><ul style="list-style: none; padding: 0px; margin: 0px; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));"><li style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.6; color: var(--offwhite); padding-left: 24px; position: relative;"><span aria-hidden="true" style="position: absolute; left: 0px; top: 10px; width: 8px; height: 1px; background: var(--copper-light);"></span>Dedicated English-speaking chauffeur for the full duration of your trip</li><li style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.6; color: var(--offwhite); padding-left: 24px; position: relative;"><span aria-hidden="true" style="position: absolute; left: 0px; top: 10px; width: 8px; height: 1px; background: var(--copper-light);"></span>Premium vehicle class matched to your group size and comfort preferences</li><li style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.6; color: var(--offwhite); padding-left: 24px; position: relative;"><span aria-hidden="true" style="position: absolute; left: 0px; top: 10px; width: 8px; height: 1px; background: var(--copper-light);"></span>Flexible day-by-day routing — Transfer, Hourly, or a combination of both</li><li style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.6; color: var(--offwhite); padding-left: 24px; position: relative;"><span aria-hidden="true" style="position: absolute; left: 0px; top: 10px; width: 8px; height: 1px; background: var(--copper-light);"></span>Driver accommodation, tolls, parking, and road taxes fully covered by PRESTIGO</li><li style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.6; color: var(--offwhite); padding-left: 24px; position: relative;"><span aria-hidden="true" style="position: absolute; left: 0px; top: 10px; width: 8px; height: 1px; background: var(--copper-light);"></span>Meet &amp; greet at airports and hotels with name-board service</li><li style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.6; color: var(--offwhite); padding-left: 24px; position: relative;"><span aria-hidden="true" style="position: absolute; left: 0px; top: 10px; width: 8px; height: 1px; background: var(--copper-light);"></span>24/7 concierge support throughout your journey for last-minute changes</li><li style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.6; color: var(--offwhite); padding-left: 24px; position: relative;"><span aria-hidden="true" style="position: absolute; left: 0px; top: 10px; width: 8px; height: 1px; background: var(--copper-light);"></span>Flight monitoring on travel days — we track delays so your schedule stays intact</li><li style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.6; color: var(--offwhite); padding-left: 24px; position: relative;"><span aria-hidden="true" style="position: absolute; left: 0px; top: 10px; width: 8px; height: 1px; background: var(--copper-light);"></span>Child seats, extra luggage space, and special requests arranged on request</li></ul></section><section aria-labelledby="multiday-how-heading" style="max-width: 960px; margin: 0px auto; padding: 48px 24px 32px;"><h2 id="multiday-how-heading" style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 32px;">How it works</h2><ol style="list-style: none; padding: 0px; margin: 0px; display: grid; gap: 0px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));"><div style="padding: 28px 24px; border-left: 1px solid var(--anthracite-light); border-bottom: 1px solid var(--anthracite-light);"><p style="font-family: var(--font-cormorant); font-size: 40px; font-weight: 400; color: var(--anthracite-light); line-height: 1; margin-bottom: 12px;">01</p><p style="font-family: var(--font-montserrat); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 10px;">Build your itinerary</p><p style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.65; color: var(--warmgrey);">Add days, choose Transfer or Hourly for each, set dates and departure times. Stops and special requests go in the notes.</p></div><div style="padding: 28px 24px; border-left: 1px solid var(--anthracite-light); border-bottom: 1px solid var(--anthracite-light);"><p style="font-family: var(--font-cormorant); font-size: 40px; font-weight: 400; color: var(--anthracite-light); line-height: 1; margin-bottom: 12px;">02</p><p style="font-family: var(--font-montserrat); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 10px;">Receive your quote</p><p style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.65; color: var(--warmgrey);">We review your route and send a fixed all-inclusive quote within 24 hours. No surprises — the price covers driver, tolls, and accommodation.</p></div><div style="padding: 28px 24px; border-left: 1px solid var(--anthracite-light); border-bottom: 1px solid var(--anthracite-light);"><p style="font-family: var(--font-cormorant); font-size: 40px; font-weight: 400; color: var(--anthracite-light); line-height: 1; margin-bottom: 12px;">03</p><p style="font-family: var(--font-montserrat); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 10px;">Confirm by email</p><p style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.65; color: var(--warmgrey);">Reply to accept. No payment link, no deposit. We confirm your booking and assign your dedicated chauffeur.</p></div><div style="padding: 28px 24px; border-left: 1px solid var(--anthracite-light); border-bottom: 1px solid var(--anthracite-light);"><p style="font-family: var(--font-cormorant); font-size: 40px; font-weight: 400; color: var(--anthracite-light); line-height: 1; margin-bottom: 12px;">04</p><p style="font-family: var(--font-montserrat); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 10px;">Travel</p><p style="font-family: var(--font-montserrat); font-size: 14px; line-height: 1.65; color: var(--warmgrey);">Your driver meets you at the first pick-up point. From that moment, logistics are ours to manage.</p></div></ol></section><section aria-labelledby="multiday-examples-heading" style="position: relative; overflow: hidden; border-top: 1px solid var(--anthracite-light);"><img alt="Scenic Central European landscape along Prestigo multi-day chauffeur itineraries" style="object-fit: cover; object-position: center; opacity: 0.22;" src="/multi-day-itineraries-bg.png"><div style="position: relative; z-index: 1; max-width: 960px; margin: 0px auto; padding: 48px 24px 32px;"><h2 id="multiday-examples-heading" style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 8px;">Example itineraries</h2><p style="font-family: var(--font-montserrat); font-size: 14px; color: var(--warmgrey); margin-bottom: 32px; line-height: 1.6;">These are real trip types we run regularly. Use them as starting points — every itinerary we quote is built from scratch around your requirements.</p><div style="display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));"><article style="background: var(--anthracite-dark); border: 1px solid var(--anthracite-light); padding: 28px;"><h3 style="font-family: var(--font-cormorant); font-size: 26px; font-weight: 400; margin-bottom: 6px; color: var(--offwhite); line-height: 1.2;">Executive trip — Prague to Vienna</h3><p style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--warmgrey); margin-bottom: 16px;">3 days · 2 transfers + city programme</p><p style="font-family: var(--font-montserrat); font-size: 13px; line-height: 1.65; color: var(--warmgrey); margin-bottom: 20px; border-left: 2px solid var(--anthracite-light); padding-left: 14px;">A classic Central European business circuit. Day one moves you from Prague to Vienna in style, with a brief stop at the Lednice château en route if time allows. Day two is yours — the chauffeur is on call for meetings, the airport, the opera, or a private wine dinner in the Wachau. Day three returns you to Prague in time for an afternoon flight.</p><ol style="list-style: none; padding: 0px; margin: 0px; display: grid; gap: 10px;"><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 1</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Prague (hotel / airport) → Vienna — ≈4 h drive, optional scenic stop</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 2</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">HOURLY</strong> — Vienna city programme — 6 h, meetings, sightseeing, or both</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 3</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Vienna → Prague (return), morning departure</span></li></ol></article><article style="background: var(--anthracite-dark); border: 1px solid var(--anthracite-light); padding: 28px;"><h3 style="font-family: var(--font-cormorant); font-size: 26px; font-weight: 400; margin-bottom: 6px; color: var(--offwhite); line-height: 1.2;">Central Europe scenic tour</h3><p style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--warmgrey); margin-bottom: 16px;">5 days · Prague → Český Krumlov → Salzburg → Munich</p><p style="font-family: var(--font-montserrat); font-size: 13px; line-height: 1.65; color: var(--warmgrey); margin-bottom: 20px; border-left: 2px solid var(--anthracite-light); padding-left: 14px;">A leisurely cultural arc through four countries. The chauffeur handles all logistics — luggage loading, hotel drop-offs, and border crossings — so you move between UNESCO sites and alpine scenery without a single logistical worry. Each city stop is long enough to feel unhurried.</p><ol style="list-style: none; padding: 0px; margin: 0px; display: grid; gap: 10px;"><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 1</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Prague → Český Krumlov — UNESCO old town, castle views</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 2</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">HOURLY</strong> — Český Krumlov exploration — 5 h guided atmosphere</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 3</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Český Krumlov → Salzburg — alpine foothills, lunch stop</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 4</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">HOURLY</strong> — Salzburg — Mozart sites, Mirabell gardens, old town — 6 h</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 5</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Salzburg → Munich (airport or hotel drop-off)</span></li></ol></article><article style="background: var(--anthracite-dark); border: 1px solid var(--anthracite-light); padding: 28px;"><h3 style="font-family: var(--font-cormorant); font-size: 26px; font-weight: 400; margin-bottom: 6px; color: var(--offwhite); line-height: 1.2;">Corporate roadshow — Prague · Brno · Warsaw</h3><p style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--warmgrey); margin-bottom: 16px;">4 days · senior team client visits across three cities</p><p style="font-family: var(--font-montserrat); font-size: 13px; line-height: 1.65; color: var(--warmgrey); margin-bottom: 20px; border-left: 2px solid var(--anthracite-light); padding-left: 14px;">Designed for senior teams running back-to-back client or investor meetings across multiple cities. One dedicated vehicle, one familiar driver, no time lost on logistics. The itinerary below is typical; we adapt departure times around your calendar in real time.</p><ol style="list-style: none; padding: 0px; margin: 0px; display: grid; gap: 10px;"><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 1</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Prague → Brno — morning departure, afternoon meetings</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 2</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">HOURLY</strong> — Brno — office visits and working lunch — 7 h on-call</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 3</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Brno → Warsaw — long-distance transfer, overnight</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 4</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">HOURLY</strong> — Warsaw city — final meetings + evening flight drop-off — 8 h</span></li></ol></article><article style="background: var(--anthracite-dark); border: 1px solid var(--anthracite-light); padding: 28px;"><h3 style="font-family: var(--font-cormorant); font-size: 26px; font-weight: 400; margin-bottom: 6px; color: var(--offwhite); line-height: 1.2;">Spa &amp; wellness retreat — Karlovy Vary</h3><p style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--warmgrey); margin-bottom: 16px;">3 days · Prague base + two full days in the spa triangle</p><p style="font-family: var(--font-montserrat); font-size: 13px; line-height: 1.65; color: var(--warmgrey); margin-bottom: 20px; border-left: 2px solid var(--anthracite-light); padding-left: 14px;">Western Bohemia's spa towns — Karlovy Vary, Mariánské Lázně, Františkovy Lázně — are just 90 minutes from Prague and among the most serene in Europe. This itinerary gives you two full unhurried days in the colonnades, with the car available for morning and evening transfers between hotels and treatment centres.</p><ol style="list-style: none; padding: 0px; margin: 0px; display: grid; gap: 10px;"><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 1</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Prague → Karlovy Vary — check-in, evening colonnade walk</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 2</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">HOURLY</strong> — Karlovy Vary &amp; surrounds — 6 h spa circuit, optional Mariánské Lázně</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 3</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Karlovy Vary → Prague — flexible departure, airport option</span></li></ol></article><article style="background: var(--anthracite-dark); border: 1px solid var(--anthracite-light); padding: 28px;"><h3 style="font-family: var(--font-cormorant); font-size: 26px; font-weight: 400; margin-bottom: 6px; color: var(--offwhite); line-height: 1.2;">Wedding weekend — private group transfer</h3><p style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--warmgrey); margin-bottom: 16px;">2 days · Prague city + Bohemian countryside venue</p><p style="font-family: var(--font-montserrat); font-size: 13px; line-height: 1.65; color: var(--warmgrey); margin-bottom: 20px; border-left: 2px solid var(--anthracite-light); padding-left: 14px;">Moving a wedding party between Prague hotels, the countryside venue, and back requires precision timing and a vehicle that matches the occasion. We coordinate with your event planner, hold waiting time between ceremony and reception, and ensure guests arrive composed.</p><ol style="list-style: none; padding: 0px; margin: 0px; display: grid; gap: 10px;"><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 1</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Prague hotels → countryside venue — ceremony and reception</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 2</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Venue → Prague (hotels + airport) — morning returns</span></li></ol></article><article style="background: var(--anthracite-dark); border: 1px solid var(--anthracite-light); padding: 28px;"><h3 style="font-family: var(--font-cormorant); font-size: 26px; font-weight: 400; margin-bottom: 6px; color: var(--offwhite); line-height: 1.2;">Wine &amp; gastronomy — Moravia</h3><p style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--warmgrey); margin-bottom: 16px;">4 days · Prague → South Moravia wine region loop</p><p style="font-family: var(--font-montserrat); font-size: 13px; line-height: 1.65; color: var(--warmgrey); margin-bottom: 20px; border-left: 2px solid var(--anthracite-light); padding-left: 14px;">Moravia's wine country sits two hours east of Prague and produces some of the best Welschriesling and Blaufränkisch in Central Europe — virtually unknown outside the region. This circuit combines cellar visits, open-air wine villages, and the Lednice–Valtice UNESCO landscape.</p><ol style="list-style: none; padding: 0px; margin: 0px; display: grid; gap: 10px;"><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 1</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Prague → Mikulov — boutique wine hotel, hillside castle</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 2</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">HOURLY</strong> — Wine cellar circuit — Valtice, Znojmo, Pálava hills — 7 h</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 3</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">HOURLY</strong> — Lednice–Valtice UNESCO landscape, afternoon tasting — 6 h</span></li><li style="display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-montserrat); font-size: 13px; line-height: 1.55; color: var(--offwhite);"><span style="font-size: 10px; letter-spacing: 0.2em; color: var(--copper-light); min-width: 52px; padding-top: 2px;">DAY 4</span><span><strong style="font-weight: 500; color: var(--copper-lighter);">TRANSFER</strong> — Mikulov → Prague (or Brno airport) — return journey</span></li></ol></article></div></div></section><section aria-labelledby="multiday-faq-heading" style="max-width: 960px; margin: 0px auto; padding: 48px 24px 32px; border-top: 1px solid var(--anthracite-light);"><h2 id="multiday-faq-heading" style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 32px;">Frequently asked questions</h2><dl style="display: grid; gap: 0px;"><div style="padding: 24px 0px; border-bottom: 1px solid var(--anthracite-light); display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px;"><dt style="font-family: var(--font-montserrat); font-size: 13px; font-weight: 500; color: var(--offwhite); line-height: 1.5;">How far in advance do I need to book?</dt><dd style="font-family: var(--font-montserrat); font-size: 13px; color: var(--warmgrey); line-height: 1.7; margin: 0px;">We accept requests up to 12 months ahead and as close as 48 hours before the first day, subject to vehicle availability. For peak periods (May–September, December) we recommend booking at least two weeks out.</dd></div><div style="padding: 24px 0px; border-bottom: 1px solid var(--anthracite-light); display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px;"><dt style="font-family: var(--font-montserrat); font-size: 13px; font-weight: 500; color: var(--offwhite); line-height: 1.5;">Can I change the itinerary after submitting?</dt><dd style="font-family: var(--font-montserrat); font-size: 13px; color: var(--warmgrey); line-height: 1.7; margin: 0px;">Yes. Once we send your quote, you can request changes before confirming. After confirmation, minor adjustments — departure times, additional stops — are handled directly with your driver. Major route changes may affect pricing.</dd></div><div style="padding: 24px 0px; border-bottom: 1px solid var(--anthracite-light); display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px;"><dt style="font-family: var(--font-montserrat); font-size: 13px; font-weight: 500; color: var(--offwhite); line-height: 1.5;">Which countries do you cover?</dt><dd style="font-family: var(--font-montserrat); font-size: 13px; color: var(--warmgrey); line-height: 1.7; margin: 0px;">Our primary territory is Czech Republic, Austria, Germany, Slovakia, Poland, and Hungary. We can also arrange transfers into Croatia, Slovenia, and the Benelux on request. Longer itineraries are quoted individually.</dd></div><div style="padding: 24px 0px; border-bottom: 1px solid var(--anthracite-light); display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px;"><dt style="font-family: var(--font-montserrat); font-size: 13px; font-weight: 500; color: var(--offwhite); line-height: 1.5;">What vehicle classes are available for multi-day trips?</dt><dd style="font-family: var(--font-montserrat); font-size: 13px; color: var(--warmgrey); line-height: 1.7; margin: 0px;">Business (Mercedes E-Class or equivalent), First Class (Mercedes S-Class or equivalent), and Business Van (Mercedes V-Class, up to 6 passengers). All classes include ample boot space; extra luggage trailers are available for group transfers.</dd></div><div style="padding: 24px 0px; border-bottom: 1px solid var(--anthracite-light); display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px;"><dt style="font-family: var(--font-montserrat); font-size: 13px; font-weight: 500; color: var(--offwhite); line-height: 1.5;">Is accommodation for the driver included?</dt><dd style="font-family: var(--font-montserrat); font-size: 13px; color: var(--warmgrey); line-height: 1.7; margin: 0px;">Yes — driver accommodation, meals on multi-day routes, and all tolls are fully included in your quote. There are no hidden surcharges.</dd></div><div style="padding: 24px 0px; border-bottom: 1px solid var(--anthracite-light); display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px;"><dt style="font-family: var(--font-montserrat); font-size: 13px; font-weight: 500; color: var(--offwhite); line-height: 1.5;">Do you provide receipts for corporate expense reporting?</dt><dd style="font-family: var(--font-montserrat); font-size: 13px; color: var(--warmgrey); line-height: 1.7; margin: 0px;">Yes. We issue a VAT invoice after the journey is complete. We can address invoices to your company and split by cost centre on request.</dd></div></dl></section><section aria-labelledby="multiday-form-heading" style="max-width: 960px; margin: 0px auto; padding: 48px 24px 64px; border-top: 1px solid var(--anthracite-light);"><h2 id="multiday-form-heading" style="font-family: var(--font-montserrat); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--copper-light); margin-bottom: 8px;">Build your itinerary</h2><p style="font-family: var(--font-montserrat); font-size: 14px; color: var(--warmgrey); margin-bottom: 32px; line-height: 1.6;">Add your days below. Each day can be a point-to-point Transfer or an Hourly block — mix freely. We’ll review and respond with a fixed quote within 24 hours.</p><div data-testid="multiday-form-marker"></div></section></main>"`;
