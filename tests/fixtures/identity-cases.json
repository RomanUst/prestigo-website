  "scenarios": [
    {
      "name": "email-merge",
      "note": "The same email always lands on the same person; every phone it brings is stored.",
      "steps": [
        {
          "email": "a",
          "phone": "+420777901101",
          "basis": "email",
          "user": null
        },
        {
          "email": "a",
          "phone": "+420777901102",
          "basis": "email",
          "user": null
        }
      ],
      "expect": {
        "identities": 1,
        "phoneMerges": 0,
        "sharedPhones": [],
        "phoneRows": 2,
        "stepIdentity": [
          0,
          0
        ],
        "stepOutcome": [
          "resolved",
          "resolved"
        ]
      }
    },
    {
      "name": "phone-merge-then-shared",
      "note": "D-04 + D-05: a new email with a known un-shared phone joins its owner, and the number is shared from then on.",
      "steps": [
        {
          "email": "a",
          "phone": "+420777901201",
          "basis": "email",
          "user": null
        },
        {
          "email": "b",
          "phone": "+420777901201",
          "basis": "email",
          "user": null
        }
      ],
      "expect": {
        "identities": 1,
        "phoneMerges": 1,
        "sharedPhones": [
          {
            "phone": "+420777901201",
            "source": "auto"
          }
        ],
        "phoneRows": 1,
        "stepIdentity": [
          0,
          0
        ],
        "stepOutcome": [
          "resolved",
          "resolved"
        ],
        "personPhones": {
          "0": []
        }
      }
    },
    {
      "name": "third-email-new-identity",
      "note": "After the one allowed phone merge the number is shared: a third email gets its own identity.",
      "steps": [
        {
          "email": "a",
          "phone": "+420777901301",
          "basis": "email",
          "user": null
        },
        {
          "email": "b",
          "phone": "+420777901301",
          "basis": "email",
          "user": null
        },
        {
          "email": "c",
          "phone": "+420777901301",
          "basis": "email",
          "user": null
        }
      ],
      "expect": {
        "identities": 2,
        "phoneMerges": 1,
        "sharedPhones": [
          {
            "phone": "+420777901301",
            "source": "auto"
          }
        ],
        "phoneRows": 1,
        "stepIdentity": [
          0,
          0,
          1
        ],
        "stepOutcome": [
          "resolved",
          "resolved",
          "resolved"
        ]
      }
    },
    {
      "name": "adjacency-single-not-shared",
      "note": "A phone seen with exactly one email is not shared, however often that email returns.",
