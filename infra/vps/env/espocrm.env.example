# infra/vps/env/espocrm.env.example
#
# Real file lives at /etc/prestigo/espocrm.env on the VPS (root:root, mode
# 600), generated once by `infra/vps/scripts/gen-env.sh espocrm` (never
# overwrites, never prints a secret). Never committed with real values — see
# infra/vps/README.md "What lives here (D-15)".

# --- MariaDB ---------------------------------------------------------------

# Generated with `openssl rand -hex 32`. Empty here - real value lives only
# on the VPS.
MARIADB_ROOT_PASSWORD=

# Fixed values, not secrets.
MARIADB_DATABASE=espocrm
MARIADB_USER=espocrm

# Generated with `openssl rand -hex 32`. Same value as
# ESPOCRM_DATABASE_PASSWORD below (one MariaDB user, one password). Empty
# here - real value lives only on the VPS.
MARIADB_PASSWORD=

# --- EspoCRM app -------------------------------------------------------

# Fixed values, not secrets.
ESPOCRM_DATABASE_PLATFORM=Mysql
ESPOCRM_DATABASE_HOST=db
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_DATABASE_USER=espocrm

# Same value as MARIADB_PASSWORD above. Empty here - real value lives only
# on the VPS.
ESPOCRM_DATABASE_PASSWORD=

# Fixed value, not a secret.
ESPOCRM_ADMIN_USERNAME=prestigo-admin

# Generated with `openssl rand -hex 24`. Empty here - real value lives only
# on the VPS. The entrypoint's own self-install (docker-entrypoint.sh
# actionInstall) creates this admin user and sets this password on first
# boot - no web installer is ever exposed (T-76-13).
ESPOCRM_ADMIN_PASSWORD=

# Fixed value, not a secret.
ESPOCRM_SITE_URL=https://crm.rideprestigo.com

# API key for the least-privilege "restore-drill-canary" API user (D-09,
# plan 76-04 Task 2 / used by plan 76-09's restore drill). Filled in on the
# VPS after the API user is created via the EspoCRM REST API - never leaves
# the VPS shell, never committed. Empty here.
ESPOCRM_CANARY_API_KEY=
