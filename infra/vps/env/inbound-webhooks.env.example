# infra/vps/env/inbound-webhooks.env.example
#
# Names and custody notes for the secrets of the two INBOUND webhooks the Prestigo site
# receives (Phase 83): Chatwoot -> /api/webhooks/chatwoot and EspoCRM ->
# /api/webhooks/espocrm. Every value is empty here: NONE of these is ever committed. The
# names are listed on purpose - the pre-commit infra secret gate (.husky/pre-commit,
# INFRA_SECRET_KEY_NAMES) derives its KEY=value block list from every
# infra/vps/env/*.env.example file, so a real value pasted next to one of these names in any
# tracked file is blocked.
#
# Custody:
#   - Chatwoot generates its webhook secret. It lives ONLY in Chatwoot (account webhook) and in
#     Vercel Production (marked sensitive). Moved between the two by a pipe, never displayed:
#     `node infra/chatwoot/webhook.mjs --print secret | vercel env add CHATWOOT_WEBHOOK_SECRET production --sensitive --yes`.
#     Rotation: infra/chatwoot/README.md, section "Inbound webhook (Phase 83)".
#   - EspoCRM returns its webhook secret once, at create. It lives in the owner file
#     ~/.config/prestigo/espocrm-webhook.env (mode 600) and in Vercel Production (sensitive).
#     Rotation: infra/espocrm/README.md.
#
# During a rotation the receiver accepts the new secret AND the previous one, so no delivery
# signed with the old secret is lost while the new one rolls out. Remove the *_PREVIOUS value
# from Vercel after the next deploy.

# Signing secret of the Chatwoot account webhook (X-Chatwoot-Signature, HMAC-SHA256).
CHATWOOT_WEBHOOK_SECRET=

# The Chatwoot signing secret that was current before the last rotation. Only set during a rotation.
CHATWOOT_WEBHOOK_SECRET_PREVIOUS=

# Signing secret of the EspoCRM webhooks (the Signature header, HMAC-SHA256 of the raw body).
ESPOCRM_WEBHOOK_SECRET=

# The EspoCRM signing secret that was current before the last rotation. Only set during a rotation.
ESPOCRM_WEBHOOK_SECRET_PREVIOUS=

# Identifier of the EspoCRM webhook record (it is encoded inside the Signature header value).
# Not a secret, but listed so the whole inbound set lives in one place.
ESPOCRM_WEBHOOK_ID=
