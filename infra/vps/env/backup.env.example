# infra/vps/env/backup.env.example
#
# Real file lives at /etc/prestigo/backup.env on the VPS (root:root, mode
# 600). Never committed with real values — see infra/vps/README.md "What
# lives here (D-15)". D-05/D-08: nightly restic backups target a Backblaze B2
# bucket through restic's S3-compatible backend (client-side encryption;
# restic's own docs recommend the S3 API over the native b2: backend, which
# has error-handling issues).
#
# Owner decision (Phase 76 plan 03, 2026-09-27): the bucket region is
# us-east-005, not an EU region. D-05 originally called for an EU bucket;
# Claude flagged the GDPR/D-05 implication and recommended a new EU-region
# account, and the owner explicitly chose to keep the existing US-East
# bucket ("оставляем"). Recorded as an owner-approved deviation — see
# 76-03-SUMMARY.md. Rationale: restic encrypts client-side before upload, so
# Backblaze never holds the encryption key; Backblaze also participates in
# the EU-US Data Privacy Framework. Region is the owner's choice and may
# differ from this example on a future re-provision — do not assume "eu-"
# when writing tooling against this file.

# restic repository URL: s3:https://<B2_S3_ENDPOINT>/<B2_BUCKET>/prestigo-vps
# Fixed value (built from the two vars below), not a secret.
RESTIC_REPOSITORY=s3:https://s3.us-east-005.backblazeb2.com/prestigo-vps-backup-7k3m/prestigo-vps

# Backblaze B2 application key ID (bucket-scoped, Read+Write only). Source:
# backblaze.com -> B2 Cloud Storage -> Application Keys -> Add, access
# limited to this bucket. Empty here — real value lives only on the VPS.
AWS_ACCESS_KEY_ID=

# Backblaze B2 application key secret, paired with the key ID above. Empty
# here — real value lives only on the VPS.
AWS_SECRET_ACCESS_KEY=

# Region portion of the B2 S3 endpoint (owner's bucket region — see note
# above; currently us-east-005). Fixed value, not a secret.
AWS_DEFAULT_REGION=us-east-005

# Backblaze B2 bucket name. Fixed value, not a secret.
B2_BUCKET=prestigo-vps-backup-7k3m

# Backblaze B2 S3-compatible endpoint hostname. Fixed value, not a secret.
B2_S3_ENDPOINT=s3.us-east-005.backblazeb2.com

# restic repository encryption password. NOT set by this plan — generated
# on the VPS by Plan 76-05 (`restic init` step) and appended there. Empty
# here — real value (when it exists) lives only on the VPS and in the
# owner's password manager, never in git.
RESTIC_PASSWORD=
