# infra/vps/env/monitor.env.example
#
# Real file lives at /etc/prestigo/monitor.env on the VPS (root:root, mode
# 600). Never committed with real values — see infra/vps/README.md "What
# lives here (D-15)".
#
# D-01/D-02/D-03: these six Healthchecks.io ping URLs are the local half of
# the alerting path built by Phase 76 plan 06. They are generated by
# infra/vps/scripts/provision-monitors.sh (never typed by hand) and installed
# on the VPS with:
#   ssh prestigo-vps 'sudo install -m 600 -o root -g root /dev/stdin /etc/prestigo/monitor.env'
#
# infra/vps/scripts/backup.sh (HC_PING_BACKUP) and infra/vps/scripts/monitor.sh
# (the other five) both source this file with `set -a; source ...; set +a`
# and treat any missing/unset key as "skip this ping, log it, keep going" —
# so this file is safe to be entirely absent (fresh host, or before Task 1's
# owner accounts exist) or partially populated.

# Pinged by infra/vps/scripts/backup.sh — start/success/fail around the
# nightly restic backup (D-03).
HC_PING_BACKUP=

# Pinged by infra/vps/scripts/monitor.sh's disk_mem check (D-04c).
HC_PING_DISK_MEM=

# Pinged by infra/vps/scripts/monitor.sh's kvm4_trigger check (D-12).
HC_PING_KVM4=

# Pinged by infra/vps/scripts/monitor.sh's sidekiq check (D-04d).
HC_PING_SIDEKIQ=

# Pinged by infra/vps/scripts/monitor.sh's espocrm_internals check (D-04d).
HC_PING_ESPOCRM=

# Pinged by infra/vps/scripts/monitor.sh's tls_expiry check (D-04b).
HC_PING_TLS=
