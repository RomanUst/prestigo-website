# infra/vps/env/smtp.env.example
#
# Real file lives at /etc/prestigo/smtp.env on the VPS (root:root, mode 600).
# Never committed with real values — see infra/vps/README.md "What lives here
# (D-15)". D-18: Chatwoot/EspoCRM system/notification mail (invites, password
# resets, agent notifications) is relayed through Resend SMTP with a
# dedicated, sending-only API key — never the site's own transactional key.

# Resend SMTP relay hostname. Fixed value, not a secret.
RESEND_SMTP_HOST=smtp.resend.com

# Submission port with STARTTLS. Fixed value, not a secret.
RESEND_SMTP_PORT=587

# Resend SMTP auth username. Always the literal string "resend" for Resend's
# SMTP relay (not an account identifier).
RESEND_SMTP_USER=resend

# Dedicated, sending-only Resend API key (permission "Sending access", domain
# rideprestigo.com). Source: resend.com dashboard -> API Keys -> Create, name
# vps-system-mail. Distinct from the site's existing Resend key so it can be
# revoked independently. Empty here — real value lives only on the VPS.
RESEND_SMTP_PASSWORD=

# From-address for VPS-originated system mail. Fixed value, not a secret.
SMTP_FROM_ADDRESS=notifications@rideprestigo.com

# From-name for VPS-originated system mail. Fixed value, not a secret.
SMTP_FROM_NAME=Prestigo
