# infra/vps/env/chatwoot.env.example
#
# Real file lives at /etc/prestigo/chatwoot.env on the VPS (root:root, mode
# 600), generated once by `infra/vps/scripts/gen-env.sh chatwoot` (never
# overwrites, never prints a secret). Never committed with real values — see
# infra/vps/README.md "What lives here (D-15)".

# --- Rails runtime ---------------------------------------------------------

# Fixed values, not secrets.
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Rails' session/cookie signing key. Generated with `openssl rand -hex 64`.
# Empty here - real value lives only on the VPS.
SECRET_KEY_BASE=

# Public URL Chatwoot uses to build links (invite emails, widget script, etc).
# Fixed value, not a secret.
FRONTEND_URL=https://chat.rideprestigo.com

# Fixed value, not a secret.
DEFAULT_LOCALE=en

# D-17: public account signup stays closed. Fixed value, not a secret. Note:
# Chatwoot's own config/installation_config.yml also defaults this to false
# at first `db:migrate`, independent of this env var - see 76-04-SUMMARY.md
# for the confirmed source of truth and the POST /api/v1/accounts probe.
ENABLE_ACCOUNT_SIGNUP=false

# --- Postgres ---------------------------------------------------------------

# Fixed value, not a secret. Matches the `postgres` service name in compose.yml.
POSTGRES_HOST=postgres

# Duplicated under both names on purpose: Rails/Chatwoot reads POSTGRES_USERNAME/
# POSTGRES_DATABASE, the official postgres image reads POSTGRES_USER/POSTGRES_DB
# to initialize itself. Fixed values, not secrets.
POSTGRES_USERNAME=postgres
POSTGRES_USER=postgres

# Generated with `openssl rand -hex 32`. Empty here - real value lives only on
# the VPS.
POSTGRES_PASSWORD=

# Fixed values, not secrets.
POSTGRES_DATABASE=chatwoot_production
POSTGRES_DB=chatwoot_production

# --- Redis --------------------------------------------------------------

# Generated with `openssl rand -hex 32`. Empty here - real value lives only on
# the VPS.
REDIS_PASSWORD=

# Built from REDIS_PASSWORD above: redis://:<REDIS_PASSWORD>@redis:6379.
# Empty here - real value (with the password embedded) lives only on the VPS.
REDIS_URL=

# --- Storage / Sidekiq (D-06, D-12) ---------------------------------------

# Fixed value, not a secret. Chatwoot attachments stay on the local
# chatwoot_storage_data Docker volume (D-06) - no S3 ActiveStorage.
ACTIVE_STORAGE_SERVICE=local

# Fixed value, not a secret.
RAILS_LOG_TO_STDOUT=true

# Fixed value, not a secret. D-12: kept low so Sidekiq can't starve
# EspoCRM/MariaDB of memory on the KVM 2 host.
SIDEKIQ_CONCURRENCY=3

# --- System mail via Resend relay (D-18) -----------------------------------
# Copied from /etc/prestigo/smtp.env by gen-env.sh - see infra/vps/env/smtp.env.example
# for the source of these values. Nothing is ever sent directly from the VPS IP.

# Fixed value, not a secret.
MAILER_SENDER_EMAIL=Prestigo <notifications@rideprestigo.com>

# Fixed value, not a secret. Matches RESEND_SMTP_HOST in smtp.env.example.
SMTP_ADDRESS=smtp.resend.com

# Fixed value, not a secret. Matches RESEND_SMTP_PORT in smtp.env.example.
SMTP_PORT=587

# Fixed value, not a secret. Matches RESEND_SMTP_USER in smtp.env.example
# (always the literal string "resend" for Resend's SMTP relay).
SMTP_USERNAME=resend

# Copied from RESEND_SMTP_PASSWORD in /etc/prestigo/smtp.env. Empty here -
# real value lives only on the VPS.
SMTP_PASSWORD=

# Fixed value, not a secret.
SMTP_AUTHENTICATION=login

# Fixed value, not a secret. STARTTLS on port 587 (not implicit TLS).
SMTP_ENABLE_STARTTLS_AUTO=true

# Fixed value, not a secret.
SMTP_DOMAIN=rideprestigo.com
