# infra/vps/env/chatwoot-integration.env.example
#
# Names and custody notes for the secrets the Prestigo site and the owner's
# workstation use to talk to Chatwoot (Phase 77). Every value is empty here:
# NONE of these is ever committed. The names are listed on purpose - the
# pre-commit infra secret gate (.husky/pre-commit, INFRA_SECRET_KEY_NAMES) derives
# its KEY=value block list from every infra/vps/env/*.env.example file, so a real
# value pasted next to one of these names in any tracked file is blocked.
# Custody and rotation: infra/chatwoot/README.md.

# Chatwoot Application API token of the owner account (Profile settings ->
# Access token). Lives only on the owner Mac in ~/.config/prestigo/chatwoot-api.env
# (mode 600). Read by infra/chatwoot/lib/client.mjs; never a command-line argument.
CHATWOOT_API_TOKEN=

# Public URL of the Chatwoot instance. Not a secret. Owner Mac
# ~/.config/prestigo/chatwoot-api.env and Vercel Production.
CHATWOOT_BASE_URL=

# Numeric Chatwoot account id. Not a secret. Owner Mac
# ~/.config/prestigo/chatwoot-api.env.
CHATWOOT_ACCOUNT_ID=

# Public web-widget identifier of the Website inbox (it is shipped to every
# visitor's browser). Not a secret. Vercel Production; readable from Chatwoot ->
# Inboxes -> Website, or `node infra/chatwoot/inspect.mjs --print website-token`
# piped into `vercel env add`.
CHATWOOT_WEBSITE_TOKEN=

# Identity-validation (HMAC) secret of the Website inbox. The site signs the
# visitor identity with it server-side. Lives ONLY in Chatwoot (Inboxes ->
# Website -> Configuration -> Identity validation) and in Vercel Production
# (marked sensitive). Moved between the two by a pipe, never displayed:
# `node infra/chatwoot/inspect.mjs --print hmac-token | vercel env add ...`.
CHATWOOT_WIDGET_HMAC_SECRET=

# Bot token of the Telegram bot behind the Telegram inbox (issued by BotFather).
# Lives on the owner Mac in ~/.config/prestigo/telegram-chat-bot.env (mode 600)
# and inside the Chatwoot Telegram inbox. Revoke with BotFather /revoke.
TELEGRAM_CHAT_BOT_TOKEN=
