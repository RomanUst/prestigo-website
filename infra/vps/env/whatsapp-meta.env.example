# infra/vps/env/whatsapp-meta.env.example
#
# Names and custody notes for the credentials of the WhatsApp Cloud API channel
# (Phase 78, dedicated business number). Every value is empty here: NONE of these
# is ever committed. The names are listed on purpose - the pre-commit infra secret
# gate (.husky/pre-commit, INFRA_SECRET_KEY_NAMES) derives its KEY=value block list
# from every infra/vps/env/*.env.example file, so a real value pasted next to one
# of the secret names below in any tracked file is blocked.
#
# Custody: the owner Mac file ~/.config/prestigo/meta-whatsapp.env (mode 600,
# created under umask 077) plus the owner's password manager. The token is also
# typed once into Chatwoot's manual WhatsApp Cloud inbox form; never into chat.
#
# The two-step verification PIN of the WhatsApp number is deliberately ABSENT from
# this file and from every other repo file, env file and script argument. It lives
# only in the owner's password manager. There is no variable for it by design.
#
# The META_WA_ prefix keeps the messaging app's credentials apart from the site's
# existing META_APP_SECRET (app/api/facebook/data-deletion), which belongs to a
# different, older Meta app.

# System User access token for the WhatsApp Cloud API. Expiration: Never.
# Permissions: whatsapp_business_management + whatsapp_business_messaging.
# Assets: the "Prestigo Messaging" app and the new WhatsApp Business Account.
# The owner types it into Chatwoot's manual inbox form; it is never sent in chat.
# SECRET.
META_WA_SYSTEM_USER_TOKEN=

# App secret of the "Prestigo Messaging" Meta app (App settings -> Basic). It is
# NOT the site's META_APP_SECRET, which belongs to the older Meta app.
# SECRET.
META_WA_APP_SECRET=

# WhatsApp Business Account id. An identifier, not a secret.
META_WA_WABA_ID=

# Cloud API phone number id of the dedicated number. An identifier, not a secret.
META_WA_PHONE_NUMBER_ID=

# Id of the "Prestigo Messaging" app. An identifier, not a secret. Only needed if
# the owner picks the document-header invoice template at the template decision
# checkpoint.
META_WA_APP_ID=

# Graph API version. Optional; when empty the tooling defaults to v25.0.
META_WA_GRAPH_VERSION=
